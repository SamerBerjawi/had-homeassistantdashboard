# ==========================================
# HOMZ Dashboard Environment Configuration
# ==========================================

# PORT: The internal port (defaults to 3000) or host port for docker-compose
PORT=3000

# HASS_URL: REQUIRED. Home Assistant instance used to validate dashboard tokens, e.g. http://homeassistant.local:8123
HASS_URL=

# AdGuard Home native stats (charts in Network > AdGuard)
#ADGUARD_URL=http://192.168.1.2:3000
#ADGUARD_USERNAME=
#ADGUARD_PASSWORD=
