# ==========================================
# HOMZ Dashboard Environment Configuration
# ==========================================

# GEMINI_API_KEY: (Optional) Required for live AI weather grounding with Google Search.
# If omitted or exhausted, the dashboard automatically uses high-fidelity realistic meteorological telemetry.
GEMINI_API_KEY=""

# PORT: The internal port (defaults to 3000) or host port for docker-compose
PORT=3000
